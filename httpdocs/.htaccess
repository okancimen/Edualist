# =====================================================
# Edualist — Performance & Cache Configuration
# =====================================================

ErrorDocument 404 /404.html

# Gzip / Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Cache lifetimes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType text/css               "access plus 6 months"
  ExpiresByType application/javascript "access plus 6 months"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType text/html              "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # the bare-domain redirect depends on these request headers
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html'">
    Header always merge Vary "Accept-Language, Cookie"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Single-hop: https + non-www bare root → www + language (avoids 2-hop chain)
  RewriteCond %{HTTPS} on
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^(/index\.html)?/?$
  RewriteCond %{HTTP_COOKIE} (^|;\s*)edualist_lang=en(;|$)
  RewriteRule ^ https://www.edualist.com/en/ [R=302,L]

  RewriteCond %{HTTPS} on
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^(/index\.html)?/?$
  RewriteCond %{HTTP_COOKIE} (^|;\s*)edualist_lang=tr(;|$)
  RewriteRule ^ https://www.edualist.com/tr/ [R=302,L]

  RewriteCond %{HTTPS} on
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^(/index\.html)?/?$
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^ https://www.edualist.com/en/ [R=302,L]

  RewriteCond %{HTTPS} on
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^(/index\.html)?/?$
  RewriteRule ^ https://www.edualist.com/tr/ [R=302,L]

  # non-www + index.html → www canonical (1 hop, before the generic non-www→www rule)
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteRule ^(.+)/index\.html$ https://www.edualist.com/$1/ [R=301,L]

  # non-www + no trailing slash + no file extension → www + slash (1 hop, prevents 2-redirect chain)
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,6}$
  RewriteRule ^(.*)$ https://www.edualist.com%{REQUEST_URI}/ [R=301,L]

  # http non-www → https www (single hop)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteRule ^ https://www.edualist.com%{REQUEST_URI} [R=301,L]

  # HTTP → HTTPS (301 permanent)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Canonical: non-www → www (301 permanent)
  RewriteCond %{HTTP_HOST} ^edualist\.com$ [NC]
  RewriteRule ^ https://www.edualist.com%{REQUEST_URI} [R=301,L]

  # Bare domain → language home: the visitor's TR/EN choice (cookie), then
  # browser language, else Turkish. Replaces the old JavaScript redirect page.
  RewriteCond %{HTTP_COOKIE} (^|;\s*)edualist_lang=en(;|$)
  RewriteRule ^(index\.html)?$ /en/ [R=302,L]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)edualist_lang=tr(;|$)
  RewriteRule ^(index\.html)?$ /tr/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^(index\.html)?$ /en/ [R=302,L]
  RewriteRule ^(index\.html)?$ /tr/ [R=302,L]

  # Strip index.html from all URLs → canonical trailing-slash form
  RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

  # 404 fix: URL with Turkish ü/ı chars → correct slug
  # Apache 2.4+ decodes URL before matching, so Unicode form is required
  RewriteRule ^blog/uluslararasi-okul-mülakatı-nasil-gecilir/?$ /blog/uluslararasi-okul-mulakati-nasil-gecilir/ [R=301,L]
  # Fallback: URL-encoded form for older Apache or proxies that pass encoded path
  RewriteRule ^blog/uluslararasi-okul-m%C3%BClakat%C4%B1-nasil-gecilir/?$ /blog/uluslararasi-okul-mulakati-nasil-gecilir/ [R=301,L]
  # 404 fix: indexed slug with dotless ı (ogrenemıyor) → correct slug (ogrenemiyor)
  RewriteRule ^blog/cocugum-ingilizce-ogrenem%C4%B1yor/?$ /blog/cocugum-ingilizce-ogrenemiyor/ [R=301,L]

  # Redirect old dubai slug to new Turkish slug (also catches /index.html variant)
  RewriteRule ^blog/dubai-school-guide(/index\.html)?/?$ /blog/dubai-gelmeden-once-bilmeniz-gerekenler/ [R=301,L]

  # GSC 404 fixes (Oct 2026)
  RewriteRule ^en/school-advisory(/index\.html)?/?$ /en/international-school-consulting/ [R=301,L]
  RewriteRule ^en/dubai-schools(/index\.html)?/?$ /en/dubai/ [R=301,L]
  RewriteRule ^en/blog/ib-vs-a-level-dubai(/index\.html)?/?$ /en/blog/ib-vs-a-level-vs-ap/ [R=301,L]
  RewriteRule ^en/blog/dubai-outstanding-schools(/index\.html)?/?$ /en/blog/dubai-khda-outstanding-schools/ [R=301,L]
  RewriteRule ^en/blog/dubai-ib-schools-results(/index\.html)?/?$ /en/blog/dubai-ib-schools-graduate-success/ [R=301,L]
  RewriteRule ^en/blog/dubai-school-application-guide(/index\.html)?/?$ /en/blog/how-to-apply-dubai-school/ [R=301,L]
  RewriteRule ^en/blog/dubai-top-10-schools(/index\.html)?/?$ /en/blog/dubai-top-schools/ [R=301,L]
  # /akademik-koçluk/ — Unicode and percent-encoded forms
  RewriteRule ^akademik-ko%C3%A7luk(/index\.html)?/?$ /uluslararasi-akademik-kocluk/ [R=301,L]
  RewriteRule ^akademik-koçluk(/index\.html)?/?$ /uluslararasi-akademik-kocluk/ [R=301,L]

  # Old stub URLs
  RewriteRule ^ib-dp-koclugu(/index\.html)?/?$ /uluslararasi-akademik-kocluk/ [R=301,L]
  RewriteRule ^blog/dubai-okul-secimi(/index\.html)?/?$ /blog/dubai-turk-aileler-okul-rehberi/ [R=301,L]
  RewriteRule ^blog/ib-alevel/?$ /blog/ib-alevel-amerikan-mufredat-karsilastirma/ [R=301,L]
  RewriteRule ^blog/dubai-okul-karsilastirma(/index\.html)?/?$ /blog/dubai-top-10-okullari/ [R=301,L]
  RewriteRule ^blog/cocugunuz-yurt-disinda-okumaya-hazir-mi(/index\.html)?/?$ /blog/cocugumu-yurtdisinda-okutmali-miyim/ [R=301,L]
  RewriteRule ^blog/cocugum-ingilizce-ogrenemiyor(/index\.html)?/?$ /blog/ingilizcesi-yetersiz-cocuk-dubai-okulu-uyum/ [R=301,L]

  # English-first posts moved under /en/blog/ (Turkish pages stay at /blog/)
  RewriteRule ^blog/what-is-pisa(/index\.html)?/?$ /en/blog/what-is-pisa/ [R=301,L]
  RewriteRule ^blog/dubai-top-schools(/index\.html)?/?$ /en/blog/dubai-top-schools/ [R=301,L]

  # Redirect misrouted language paths under /blog/
  RewriteRule ^blog/en/?$ /en/ [R=301,L]
  RewriteRule ^blog/tr/?$ /tr/ [R=301,L]

  # Serve WebP if browser supports it and file exists
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} \.(png|jpg|jpeg)$
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(.+)\.(png|jpg|jpeg)$ $1.$2.webp [T=image/webp,L]
</IfModule>
